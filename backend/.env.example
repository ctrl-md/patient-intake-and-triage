PORT=8080
DATABASE_URL=postgres://triagely:triagely@localhost:5432/triagely?sslmode=disable

# Required. At least 32 characters. Make one with: openssl rand -hex 32
# (no openssl on Windows? use any long random text)
JWT_SECRET=
# How long a login lasts (12h, 30m, ...)
JWT_TTL=12h

# Where the patient chat page runs. Used to build the intake link.
FRONTEND_URL=http://localhost:3000
# How long a new intake link works
INTAKE_TTL=24h

# Browser origins allowed to call the API (comma separated). Default: FRONTEND_URL.
# Must match the browser address exactly: localhost and 127.0.0.1 are different origins.
CORS_ORIGINS=http://localhost:3000

# ---- AI (optional) ----
# Leave LLM_API_KEY empty to run without AI. Rules and fixed questions still work.
# gemini key: https://aistudio.google.com/apikey   groq key: https://console.groq.com/keys
LLM_PROVIDER=gemini
LLM_API_KEY=
# Model names change often. If you get a "model not found" error, set this to a current one.
# Empty uses: gemini-2.5-flash (gemini) or llama-3.3-70b-versatile (groq)
LLM_MODEL=
# Max wait per AI call
LLM_TIMEOUT=20s
